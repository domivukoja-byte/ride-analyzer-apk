--- cpython-3.11.4/Modules/grpmodule.c
+++ cpython-3.11.4.mod/Modules/grpmodule.c
@@ -7,1 +7,10 @@
 #include <grp.h>
+
+/* Android NDK r28+ doesn't declare setgrent/getgrent/endgrent in
+ * <grp.h>. Clang treats calls to undeclared functions as errors under
+ * -Wimplicit-function-declaration. Declare them here to match the
+ * 3.11.4 grpmodule.c usage. */
+extern void setgrent(void);
+extern struct group *getgrent(void);
+extern void endgrent(void);
